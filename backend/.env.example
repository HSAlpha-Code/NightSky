# Copy to .env and adjust. Real environment variables override values in .env.
# On Vercel, set these in Project Settings -> Environment Variables instead (see DEPLOY.md).
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Default: 1 locally, 0 on Vercel.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOW_ALL_ORIGINS=1

# Cache: "locmem" (default), "file", or "redis" (needs CACHE_LOCATION, e.g. redis://localhost:6379/0)
CACHE_BACKEND=locmem
CACHE_LOCATION=
CACHE_TIMEOUT_SECONDS=86400

# External HTTP calls (read timeout, connect timeout, retries on timeout/429/5xx)
HTTP_TIMEOUT_SECONDS=25
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_RETRIES=1

# Image providers
DEFAULT_PROVIDER=dss2_color
HIPS2FITS_URL=https://alasky.cds.unistra.fr/hips-image-services/hips2fits
# Mirror if the main CDS host is unreachable:
# HIPS2FITS_URL=https://alaskybis.cds.unistra.fr/hips-image-services/hips2fits
# If CDS is unreachable (some ISPs can't route to Strasbourg), DSS2/2MASS/AllWISE are rendered
# locally from this HiPS mirror (ESA ESASky). Empty = disabled.
HIPS_MIRROR_URL=https://skies.esac.esa.int
SKYVIEW_URL=https://skyview.gsfc.nasa.gov/current/cgi/runquery.pl
PANSTARRS_URL=https://ps1images.stsci.edu/cgi-bin
# Skip a failing upstream service for this many seconds before trying it again
PROVIDER_DOWN_SECONDS=120

# Plate solver: "tetra3" (default)
PLATE_SOLVER=tetra3
# Optional path to a custom tetra3 database (.npz). Empty = tetra3's bundled default (10-30 deg FOV).
TETRA3_DATABASE=
TETRA3_SOLVE_TIMEOUT_MS=10000
# FOV reported for sensor-only results when the phone sends no fov_deg
DEFAULT_FOV_DEG=60
# Let astropy download fresh Earth-rotation (IERS) tables; off = use bundled tables
ASTROPY_IERS_AUTO_DOWNLOAD=0
