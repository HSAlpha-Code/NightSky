<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="12dp" android:gravity="center_vertical" android:background="#10131C">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_text" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="16sp" />
</LinearLayout>
